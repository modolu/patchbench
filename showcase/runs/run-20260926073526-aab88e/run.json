  "issue": {
    "title": "Expired refresh token returns HTTP 500 instead of the documented 401",
    "description": "POST /auth/refresh with a refresh token past its expiry responds 500 internal_error. AuthService.refresh throws TokenExpiredError, which the HTTP error mapper does not handle, so clients treat an expired session as an outage and retry.",
    "expectedBehavior": "POST /auth/refresh with an expired refresh token responds 401. All other documented auth responses are unchanged.",
    "actualBehavior": "500 {\"error\":\"internal_error\"}"
  },
